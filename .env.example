# Machine-local build configuration.
#
# direnv copies this file to .env.local on first use; edit .env.local, never
# this file. .env.local is git-ignored, this one is not, so keep it free of
# anything specific to your machine. Taskfile.yml reads .env.local directly, so
# direnv is optional.

# Code signing identity used by `task build`, `task build:release` and
# `task install`.
#
#   -   Ad-hoc signing. No certificate is involved, so the app's designated
#       requirement is the build's own hash: every rebuild looks like a
#       different app to macOS and Accessibility permission has to be granted
#       again. Fine for a one-off check, painful for daily use.
#
# For a stable identity, name a certificate from
#   security find-identity -v -p codesigning
# for example "Apple Development: you@example.com (XXXXXXXXXX)".
# See the signing section of CLAUDE.md.
MC_CODE_SIGN_IDENTITY=-

# Team ID of that certificate: the OU field of its subject, visible with
#   security find-certificate -c "<identity>" -p | openssl x509 -noout -subject
# Leave empty when MC_CODE_SIGN_IDENTITY is "-".
MC_DEVELOPMENT_TEAM= #optional #regex=^[A-Z0-9]{10}$
